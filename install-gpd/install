#!/usr/bin/env bash
# GPD — Get Physics Done: unified CLI installer
#
# Usage:
#   curl -fsSL https://download.gpd.psi.inc/install | bash
#   curl -fsSL https://download.gpd.psi.inc/install | bash -s -- --skip-key
#   bash install --version 1.0.180
#
# Installs: OpenCode CLI, Python 3.11+ (app-local if needed), GPD package,
# LiteLLM key config, and `gpd` wrapper command.
# Everything goes into ~/.gpd/ — no system-wide changes except PATH in shell rc.

set -euo pipefail

# ── Configuration ──────────────────────────────────────────────────────────

GPD_HOME="${GPD_HOME:-$HOME/.gpd}"
GPD_BIN_DIR="$GPD_HOME/bin"
GPD_PYTHON_DIR="$GPD_HOME/python"
GPD_VENV_DIR="$GPD_HOME/venv"
GPD_CONFIG_DIR="$GPD_HOME/config"

OPENCODE_ORG="psi-oss"
OPENCODE_REPO="opencode"
OPENCODE_FALLBACK_ORG="anomalyco"
OPENCODE_FALLBACK_REPO="opencode"

GPD_PACKAGE_REPO="psi-oss/get-physics-done"
GPD_PACKAGE_BRANCH="main"

LITELLM_PROXY_URL="https://litellm-production-46bb.up.railway.app"

# Python-build-standalone: portable, relocatable CPython builds from Astral.
PBS_TAG="20250409"
PBS_PYTHON="3.13.3"
PBS_BASE_URL="https://github.com/astral-sh/python-build-standalone/releases/download/$PBS_TAG"

REQUIRED_PYTHON_MAJOR=3
REQUIRED_PYTHON_MINOR=11

# ── Colors & logging ──────────────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

log()     { printf " ${CYAN}i${RESET} %s\n" "$*"; }
success() { printf " ${GREEN}✓${RESET} %s\n" "$*"; }
warn()    { printf " ${YELLOW}⚠${RESET} %s\n" "$*"; }
error()   { printf " ${RED}✗${RESET} %s\n" "$*" >&2; }
die()     { error "$@"; exit 1; }

# ── Argument parsing ──────────────────────────────────────────────────────

usage() {
    cat <<EOF
GPD — Get Physics Done: CLI Installer

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific OpenCode version
        --no-modify-path    Don't modify shell config files
        --skip-key          Skip PSI API key prompt

Examples:
    curl -fsSL https://download.gpd.psi.inc/install | bash
    curl -fsSL https://download.gpd.psi.inc/install | bash -s -- --skip-key
    bash install --version 1.0.180
EOF
}

requested_version=""
no_modify_path=false
skip_key=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)     usage; exit 0 ;;
        -v|--version)
            [[ -n "${2:-}" ]] || { error "--version requires an argument"; exit 1; }
            requested_version="${2#v}"
            shift 2 ;;
        --no-modify-path) no_modify_path=true; shift ;;
        --skip-key)       skip_key=true; shift ;;
        *)  warn "Unknown option: $1"; shift ;;
    esac
done

# ── Platform detection ────────────────────────────────────────────────────

detect_platform() {
    local raw_os
    raw_os="$(uname -s)"
    case "$raw_os" in
        Darwin*)                os="darwin" ;;
        Linux*)                 os="linux" ;;
        MINGW*|MSYS*|CYGWIN*)  die "Windows detected. Use the PowerShell installer or download the desktop app at https://download.gpd.psi.inc" ;;
        *)                      die "Unsupported OS: $raw_os" ;;
    esac

    arch="$(uname -m)"
    case "$arch" in
        x86_64|amd64)   arch="x64" ;;
        aarch64|arm64)   arch="arm64" ;;
        *)               die "Unsupported architecture: $arch" ;;
    esac

    # Rosetta detection on macOS
    if [[ "$os" == "darwin" && "$arch" == "x64" ]]; then
        local rosetta
        rosetta="$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)"
        [[ "$rosetta" == "1" ]] && arch="arm64"
    fi

    # musl detection on Linux
    is_musl=false
    if [[ "$os" == "linux" ]]; then
        [[ -f /etc/alpine-release ]] && is_musl=true
        if command -v ldd &>/dev/null && ldd --version 2>&1 | grep -qi musl; then
            is_musl=true
        fi
    fi
}

# ── Prerequisites ─────────────────────────────────────────────────────────

check_prerequisites() {
    # curl is needed to bootstrap — can't auto-install since we need it to
    # fetch the installer in the first place
    command -v curl &>/dev/null || die "'curl' is required but not installed."

    if [[ "$os" == "linux" ]] && command -v apt-get &>/dev/null; then
        # Collect missing tools and install them in a single apt transaction
        local missing=()
        for cmd in tar unzip git; do
            command -v "$cmd" &>/dev/null || missing+=("$cmd")
        done

        # python3-venv: test actual venv creation (--help can exit 0 even
        # when ensurepip is missing), use version-specific package name
        if command -v python3 &>/dev/null; then
            local test_venv
            test_venv="$(mktemp -d)"
            if ! python3 -m venv "$test_venv" &>/dev/null; then
                local pyver
                pyver="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
                missing+=("python${pyver}-venv")
            fi
            rm -rf "$test_venv"
        fi

        if (( ${#missing[@]} > 0 )); then
            log "Installing system dependencies: ${missing[*]}"
            sudo apt-get update -qq
            sudo apt-get install -y -qq "${missing[@]}" || \
                die "Failed to install system deps: ${missing[*]}"
        fi
    elif [[ "$os" == "darwin" ]]; then
        # On macOS we intentionally skip probing for `git` and `python3`.
        #
        # Apple ships /usr/bin/git and /usr/bin/python3 as STUBS that pop a
        # "Install the Xcode Command Line Tools?" GUI dialog the moment they
        # are invoked on a Mac without the full CLT package installed. The
        # dialog blocks the process, never returns from SSH, and can kick off
        # a ~1 GB download if the user clicks the wrong button. Even
        # `command -v` returns the stub path, so probing either tool is a
        # trap: detection succeeds but invocation is the footgun.
        #
        # Our installer does not actually need git (it pulls get-physics-done
        # as a tarball via curl, not a git clone) and it does not need the
        # system python3 (we bootstrap an app-local standalone Python via
        # python-build-standalone further down in ensure_python). So we just
        # stop checking. `curl`, `tar`, `unzip` ARE real on macOS and safe.
        for cmd in tar unzip; do
            command -v "$cmd" &>/dev/null || die "'$cmd' is required but not installed."
        done
    else
        # Non-Debian Linux (Fedora, Arch, etc.): can't auto-install, just die.
        for cmd in tar git; do
            command -v "$cmd" &>/dev/null || die "'$cmd' is required but not installed."
        done
    fi
}

# ── LaTeX ─────────────────────────────────────────────────────────────────
# Optional dependency for physics paper compilation. Warns on failure.

install_latex() {
    if command -v pdflatex &>/dev/null; then
        success "LaTeX already installed"
        return 0
    fi

    log "Installing LaTeX tools (~500MB download, takes a few minutes)..."

    case "$os" in
        linux)
            if ! command -v apt-get &>/dev/null; then
                warn "LaTeX auto-install only supports apt-based distros — install manually"
                return 0
            fi
            sudo apt-get install -y -qq texlive-latex-base texlive-binaries latexmk 2>&1 | tail -5 || \
                warn "LaTeX install failed — run: sudo apt install texlive-latex-base texlive-binaries latexmk"
            ;;
        darwin)
            if ! command -v brew &>/dev/null; then
                warn "Homebrew not found — skipping LaTeX. Install from https://brew.sh, then: brew install --cask basictex"
                return 0
            fi
            brew install --cask basictex 2>&1 | tail -5 || \
                warn "BasicTeX install failed — run: brew install --cask basictex"
            local texbin="/Library/TeX/texbin"
            if [[ -x "$texbin/tlmgr" ]]; then
                sudo "$texbin/tlmgr" update --self 2>/dev/null || true
                sudo "$texbin/tlmgr" install latexmk 2>&1 | tail -3 || \
                    warn "latexmk install failed — run: sudo tlmgr install latexmk"
                export PATH="$texbin:$PATH"
            fi
            ;;
    esac

    if command -v pdflatex &>/dev/null; then
        success "LaTeX installed"
    else
        warn "LaTeX install completed but pdflatex not on PATH yet — open a new shell"
    fi
}

# ── Utilities ─────────────────────────────────────────────────────────────

download() {
    local url="$1" dest="$2"
    log "Downloading $(basename "$dest")..."
    if command -v curl &>/dev/null; then
        curl -fsSL --retry 3 --retry-delay 2 -o "$dest" "$url"
    elif command -v wget &>/dev/null; then
        wget -q --tries=3 -O "$dest" "$url"
    else
        die "Neither curl nor wget found."
    fi
}

url_exists() {
    curl -fsSL --head --retry 1 --max-time 10 -o /dev/null "$1" 2>/dev/null
}

# ── Banner ────────────────────────────────────────────────────────────────

print_banner() {
    printf "\n"
    printf "${CYAN} ██████╗ ██████╗ ██████╗${RESET}\n"
    printf "${CYAN}██╔════╝ ██╔══██╗██╔══██╗${RESET}\n"
    printf "${CYAN}██║  ███╗██████╔╝██║  ██║${RESET}\n"
    printf "${CYAN}██║   ██║██╔═══╝ ██║  ██║${RESET}\n"
    printf "${CYAN}╚██████╔╝██║     ██████╔╝${RESET}\n"
    printf "${CYAN} ╚═════╝ ╚═╝     ╚═════╝${RESET}\n"
    printf "\n"
    printf " ${BOLD}Get Physics Done${RESET} ${DIM}— CLI Installer${RESET}\n"
    printf " Open-source AI copilot for physics research\n"
    printf "\n"
}

# ── Step 1: OpenCode CLI binary ───────────────────────────────────────────

opencode_asset_name() {
    case "$os" in
        linux)  echo "opencode-linux-${arch}.tar.gz" ;;
        darwin) echo "opencode-darwin-${arch}.zip" ;;
    esac
}

# Install the GPD desktop .deb on Debian/Ubuntu. Die on failure — the .deb
# is the primary experience on these systems; a silent fallback to CLI-only
# would leave users without the GUI/menu entry they expect.
install_gpd_deb() {
    local dest="$1"

    # Already installed? Symlink CLI and return.
    if [[ -x "/usr/bin/opencode-cli" ]] && [[ -x "/usr/bin/GPD" ]]; then
        success "GPD desktop app already installed"
        ln -sf /usr/bin/opencode-cli "$dest" 2>/dev/null || true
        return 0
    fi

    # Discover .deb URL via web redirect (no API rate limit)
    local tag deb_url
    tag="$(curl -fsSLI --max-time 10 "https://github.com/${OPENCODE_ORG}/${OPENCODE_REPO}/releases/latest" 2>/dev/null \
        | grep -i '^location:' | tail -1 | grep -oE 'tag/[^ ]*' | sed 's|tag/||' | tr -d '\r\n')" || true

    [[ -n "$tag" ]] || die "Could not discover latest GPD release tag. Check network connectivity."

    local ver="${tag#*-v}"
    deb_url="https://github.com/${OPENCODE_ORG}/${OPENCODE_REPO}/releases/download/${tag}/GPD_${ver}_amd64.deb"

    url_exists "$deb_url" || die "GPD .deb not found at $deb_url (arch mismatch or missing release asset)"

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    trap "rm -rf '$tmp_dir'" RETURN
    local deb_file="$tmp_dir/gpd.deb"

    download "$deb_url" "$deb_file"
    log "Installing GPD desktop app (.deb, ~80MB)..."
    sudo dpkg -i "$deb_file" 2>&1 || sudo apt-get install -f -y -qq 2>&1 || \
        die "dpkg install failed. Check sudo access and disk space."

    if [[ -x "/usr/bin/opencode-cli" ]]; then
        ln -sf /usr/bin/opencode-cli "$dest"
        success "GPD desktop app installed (CLI: /usr/bin/opencode-cli, GUI: /usr/bin/GPD)"
        return 0
    fi

    die ".deb install completed but /usr/bin/opencode-cli not found"
}

install_opencode() {
    local dest="$GPD_BIN_DIR/opencode"

    if [[ -x "$dest" ]]; then
        success "OpenCode CLI already installed"
        return 0
    fi

    # On Debian/Ubuntu (dpkg + sudo), the .deb is the primary install path
    # and a failure is fatal. On other Linux (no dpkg), fall back to the
    # standalone CLI binary.
    if [[ "$os" == "linux" ]] && command -v dpkg &>/dev/null && command -v sudo &>/dev/null; then
        install_gpd_deb "$dest"
        return 0
    fi

    local asset
    asset="$(opencode_asset_name)"
    local gpd_url="https://github.com/${OPENCODE_ORG}/${OPENCODE_REPO}/releases/latest/download/${asset}"
    local fallback_url="https://github.com/${OPENCODE_FALLBACK_ORG}/${OPENCODE_FALLBACK_REPO}/releases/latest/download/${asset}"

    local url=""
    if [[ -n "$requested_version" ]]; then
        url="https://github.com/${OPENCODE_FALLBACK_ORG}/${OPENCODE_FALLBACK_REPO}/releases/download/v${requested_version}/${asset}"
    elif url_exists "$gpd_url"; then
        url="$gpd_url"
    elif url_exists "$fallback_url"; then
        url="$fallback_url"
    else
        die "Could not find OpenCode CLI binary for ${os}/${arch}."
    fi

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    local archive="$tmp_dir/$asset"
    download "$url" "$archive"

    log "Extracting OpenCode CLI..."
    case "$asset" in
        *.tar.gz) tar -xzf "$archive" -C "$tmp_dir" ;;
        *.zip)    unzip -qo "$archive" -d "$tmp_dir" ;;
    esac

    local binary
    binary="$(find "$tmp_dir" -name 'opencode' -type f -not -path "$archive" | head -1)"
    [[ -n "$binary" ]] || { rm -rf "$tmp_dir"; die "Could not find opencode binary in archive"; }

    mv "$binary" "$dest"
    chmod +x "$dest"
    rm -rf "$tmp_dir"
    success "OpenCode CLI installed (standalone, no desktop app)"
}

# ── Step 2: Python ────────────────────────────────────────────────────────

python_version_ok() {
    local python="$1"
    local ver
    ver="$("$python" --version 2>&1)" || return 1
    local nums
    nums="$(echo "$ver" | grep -oE '[0-9]+\.[0-9]+' | head -1)"
    local major="${nums%%.*}" minor="${nums##*.}"
    [[ -n "$major" && -n "$minor" ]] || return 1
    (( major > REQUIRED_PYTHON_MAJOR || (major == REQUIRED_PYTHON_MAJOR && minor >= REQUIRED_PYTHON_MINOR) ))
}

pbs_triple() {
    case "${os}_${arch}" in
        linux_x64)    echo "x86_64-unknown-linux-gnu" ;;
        linux_arm64)  echo "aarch64-unknown-linux-gnu" ;;
        darwin_x64)   echo "x86_64-apple-darwin" ;;
        darwin_arm64)  echo "aarch64-apple-darwin" ;;
        *)            die "No python-build-standalone for ${os}/${arch}" ;;
    esac
}

ensure_python() {
    local python_bin="$GPD_PYTHON_DIR/bin/python3"

    # Check app-local Python first (works on all platforms)
    if [[ -x "$python_bin" ]] && python_version_ok "$python_bin"; then
        success "Using app-local Python"
        PYTHON="$python_bin"
        return 0
    fi

    # Check system Python -- but NOT on macOS.
    #
    # /usr/bin/python3 on macOS is a stub that pops a GUI "Install Xcode
    # Command Line Tools?" dialog the moment it's invoked on a Mac without
    # the full CLT package. `command -v` returns the stub path (detection
    # succeeds), but then `python_version_ok` runs the stub and triggers
    # the dialog from what the user expects to be a silent installer.
    # Skip the probe entirely; we always download the app-local standalone
    # Python on macOS (30MB, offline-friendly, no CLT dependency).
    if [[ "$os" != "darwin" ]]; then
        for cmd in python3 python; do
            if command -v "$cmd" &>/dev/null && python_version_ok "$cmd"; then
                local ver
                ver="$("$cmd" --version 2>&1)"
                success "Found system $ver"
                PYTHON="$(command -v "$cmd")"
                return 0
            fi
        done
    fi

    # Download standalone Python (always on macOS; Linux only if system
    # python3 is missing or older than 3.11)
    log "Installing app-local Python ${PBS_PYTHON} (${REQUIRED_PYTHON_MAJOR}.${REQUIRED_PYTHON_MINOR}+ not found or Mac)"
    local triple
    triple="$(pbs_triple)"
    local filename="cpython-${PBS_PYTHON}+${PBS_TAG}-${triple}-install_only.tar.gz"
    local url="${PBS_BASE_URL}/${filename}"

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    download "$url" "$tmp_dir/$filename"

    log "Extracting Python to $GPD_PYTHON_DIR..."
    rm -rf "$GPD_PYTHON_DIR"
    mkdir -p "$GPD_PYTHON_DIR"
    tar -xzf "$tmp_dir/$filename" -C "$GPD_PYTHON_DIR" --strip-components=1
    rm -rf "$tmp_dir"

    [[ -x "$python_bin" ]] || die "Python extraction failed"
    success "Python ${PBS_PYTHON} installed"
    PYTHON="$python_bin"
}

# ── Step 3: Venv & GPD package ────────────────────────────────────────────

install_gpd_package() {
    if [[ -f "$GPD_VENV_DIR/bin/python" || -f "$GPD_VENV_DIR/bin/python3" ]]; then
        success "Python venv already exists"
    else
        log "Creating virtual environment..."
        "$PYTHON" -m venv "$GPD_VENV_DIR"
    fi

    local venv_python="$GPD_VENV_DIR/bin/python"
    local venv_pip="$GPD_VENV_DIR/bin/pip"

    "$venv_python" -m pip install --upgrade --quiet pip

    local source_url="https://github.com/${GPD_PACKAGE_REPO}/archive/refs/heads/${GPD_PACKAGE_BRANCH}.tar.gz"
    log "Installing get-physics-done from GitHub..."
    "$venv_pip" install --upgrade --quiet "$source_url"

    [[ -x "$GPD_VENV_DIR/bin/gpd" ]] || die "GPD installation failed — gpd command not found"
    success "GPD package installed"
}

# ── Step 4: LiteLLM key ──────────────────────────────────────────────────

configure_litellm_key() {
    local env_file="$GPD_CONFIG_DIR/litellm.env"

    if [[ -f "$env_file" ]]; then
        success "PSI key already configured"
        return 0
    fi

    if [[ "$skip_key" == true ]]; then
        warn "Skipping PSI key (use --skip-key or set GPD_API_KEY env var)"
        return 0
    fi

    # Check for env var (non-interactive mode)
    local key="${GPD_API_KEY:-${GPD_LITELLM_KEY:-}}"
    if [[ -n "$key" ]]; then
        : # key already set from env
    elif [[ ! -t 0 ]]; then
        warn "Non-interactive mode: set GPD_API_KEY env var or run 'gpd config set-key' after install"
        return 0
    else
        printf "\n"
        printf " ${BOLD}PSI API Key Configuration${RESET}\n"
        printf " ${DIM}Your PSI key connects GPD to AI models. Get it from your lab admin.${RESET}\n"
        printf "\n"

        local key=""
        while [[ -z "$key" ]]; do
            printf " Enter your PSI key (sk-...): "
            read -r key
            [[ -n "$key" ]] || warn "Key cannot be empty. Ctrl+C to skip."
        done
    fi

    ( umask 077; cat > "$env_file" <<EOF
# GPD configuration — used by CLI wrapper and sourced into desktop app session
GPD_API_KEY=${key}
LITELLM_API_BASE=${LITELLM_PROXY_URL}
EOF
    )

    # Export GPD_API_KEY in login profile so the desktop app inherits it
    local profile="$HOME/.profile"
    [[ "$(basename "${SHELL:-bash}")" == "zsh" ]] && profile="${ZDOTDIR:-$HOME}/.zprofile"
    local export_line="export GPD_API_KEY=\"${key}\""
    if ! grep -qF "GPD_API_KEY" "$profile" 2>/dev/null; then
        printf '\n# GPD API key for desktop app\n%s\n' "$export_line" >> "$profile"
    fi

    # Also write the key into opencode's auth.json so the GPD desktop app
    # can see an existing auth entry on first launch and skip its own
    # "enter your key" welcome screen. Without this, users who install via
    # the CLI installer and enter their PSI key here still get prompted
    # again when they open the desktop app (matching fix in
    # packages/app/src/app.tsx:SetupGate).
    #
    # auth.json path follows XDG: ~/.local/share/opencode/auth.json on
    # Linux, ~/Library/Application Support/opencode/auth.json on macOS.
    # Format: {"<providerID>": {"type":"api","key":"sk-..."}}
    local xdg_data="${XDG_DATA_HOME:-$HOME/.local/share}"
    if [[ "$os" == "darwin" ]]; then
        xdg_data="$HOME/Library/Application Support"
    fi
    local auth_dir="$xdg_data/opencode"
    local auth_file="$auth_dir/auth.json"
    mkdir -p "$auth_dir"
    # If auth.json already has other providers, preserve them. Otherwise
    # write a fresh one. Prefer the app-local Python we just installed —
    # using bare `python3` on a fresh macOS where Xcode CLT is absent
    # triggers the "install developer tools" GUI prompt even though the
    # stub succeeds `command -v` checks.
    local merger_python=""
    if [[ -n "${PYTHON:-}" && -x "${PYTHON:-}" ]]; then
        merger_python="$PYTHON"
    elif [[ -x "$GPD_VENV_DIR/bin/python" ]]; then
        merger_python="$GPD_VENV_DIR/bin/python"
    fi
    if [[ -f "$auth_file" && -n "$merger_python" ]]; then
        "$merger_python" - "$auth_file" "$key" <<'PY'
import json, os, sys, stat
path, key = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    data = {}
data["gpd"] = {"type": "api", "key": key}
with open(path, "w") as f:
    json.dump(data, f, indent=2)
os.chmod(path, 0o600)
PY
    else
        ( umask 077; printf '{\n  "gpd": {\n    "type": "api",\n    "key": "%s"\n  }\n}\n' "$key" > "$auth_file" )
    fi

    success "PSI key saved"
}

# ── Step 5: GPD wrapper ──────────────────────────────────────────────────

create_gpd_wrapper() {
    local wrapper="$GPD_BIN_DIR/gpd"

    cat > "$wrapper" <<'WRAPPER'
#!/usr/bin/env bash
GPD_HOME="${GPD_HOME:-$HOME/.gpd}"
if [[ -f "$GPD_HOME/config/litellm.env" ]]; then
    set -a; source "$GPD_HOME/config/litellm.env"; set +a
fi
export PATH="$GPD_HOME/venv/bin:$GPD_HOME/bin:$PATH"
exec "$GPD_HOME/bin/opencode" "$@"
WRAPPER
    chmod +x "$wrapper"
    success "GPD wrapper created"
}

# ── Step 6: PATH ─────────────────────────────────────────────────────────

configure_path() {
    if [[ "$no_modify_path" == true ]]; then
        log "Skipping PATH modification (--no-modify-path)"
        return 0
    fi

    # Already on PATH?
    if echo "$PATH" | tr ':' '\n' | grep -qxF "$GPD_BIN_DIR"; then
        success "$GPD_BIN_DIR already on PATH"
        return 0
    fi

    local entry="export PATH=\"$GPD_BIN_DIR:\$PATH\""
    local current_shell
    current_shell="$(basename "${SHELL:-bash}")"
    local added=false

    # Determine rc files by shell
    local rc_files
    case "$current_shell" in
        fish) rc_files="$HOME/.config/fish/config.fish" ;;
        zsh)  rc_files="${ZDOTDIR:-$HOME}/.zshrc" ;;
        *)    rc_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile" ;;
    esac

    for rc in $rc_files; do
        if [[ -f "$rc" ]] && ! grep -qF "$GPD_BIN_DIR" "$rc"; then
            if [[ "$current_shell" == "fish" ]]; then
                printf '\n# GPD CLI\nfish_add_path %s\n' "$GPD_BIN_DIR" >> "$rc"
            else
                printf '\n# GPD CLI\n%s\n' "$entry" >> "$rc"
            fi
            log "Added to $rc"
            added=true
            break
        fi
    done

    if [[ "$added" == false ]]; then
        local target="$HOME/.bashrc"
        [[ "$current_shell" == "zsh" ]] && target="$HOME/.zshrc"
        printf '\n# GPD CLI\n%s\n' "$entry" >> "$target"
        log "Added to $target"
    fi

    # GitHub Actions support
    if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
        echo "$GPD_BIN_DIR" >> "$GITHUB_PATH"
    fi

    export PATH="$GPD_BIN_DIR:$PATH"
    success "PATH configured"
}

# ── Step 7: GPD runtime config ───────────────────────────────────────────

configure_gpd_runtime() {
    # Run from $HOME so gpd's checkout-root detection doesn't try to read
    # an unreadable cwd (e.g. /root when script is run via sudo).
    if [[ -x "$GPD_VENV_DIR/bin/python" ]]; then
        log "Configuring GPD for OpenCode..."
        if ! ( cd "$HOME" && "$GPD_VENV_DIR/bin/python" -m gpd.cli install opencode --global --skip-readiness-check ); then
            warn "GPD runtime configuration failed. Run manually from your home dir:"
            warn "  cd ~ && ~/.gpd/venv/bin/gpd install opencode --global"
        fi
    fi

    # Write the .gpd-initialized marker so the GPD desktop app's first-run
    # setup short-circuits via is_venv_valid() -- no uv/python/pip cascade
    # of console windows, no ~3 minutes of re-downloading what we just
    # installed. The app looks for this file at $GPD_HOME/.gpd-initialized
    # (matches the unified path in packages/desktop/src-tauri/src/gpd_setup.rs).
    if [[ -f "$GPD_VENV_DIR/bin/gpd" ]] || [[ -f "$GPD_VENV_DIR/bin/python" ]]; then
        local marker="$GPD_HOME/.gpd-initialized"
        if [[ ! -f "$marker" ]]; then
            printf 'initialized\n' > "$marker"
            success "GPD desktop app will skip first-run setup"
        fi
    fi
}

# ── Success ──────────────────────────────────────────────────────────────

print_success() {
    local has_desktop=false
    [[ -x "/usr/bin/GPD" ]] && has_desktop=true

    printf "\n"
    success "GPD installed successfully!"
    printf "\n"

    if [[ "$has_desktop" == true ]]; then
        printf "  ${BOLD}Desktop app${RESET} ${DIM}(recommended)${RESET}\n"
        printf "    Launch ${BOLD}GPD${RESET} from your applications menu.\n"
        printf "    ${DIM}You may be asked for your PSI key again on first launch —${RESET}\n"
        printf "    ${DIM}use the same key you entered here.${RESET}\n"
        printf "\n"
        printf "  ${BOLD}CLI${RESET}\n"
        printf "    Open a ${BOLD}new terminal${RESET}, then run: ${BOLD}gpd${RESET}\n"
    else
        printf "  Run GPD: open a ${BOLD}new terminal${RESET}, then type ${BOLD}gpd${RESET}\n"
    fi
    printf "\n"
    printf "  ${DIM}Installed to: %s${RESET}\n" "$GPD_HOME"
    printf "\n"
    warn "PATH changes don't apply to THIS terminal — open a new one to use 'gpd'."
    printf "\n"
}

# ── Main ─────────────────────────────────────────────────────────────────

main() {
    detect_platform
    print_banner

    log "Installing GPD to $GPD_HOME"
    log "Platform: ${os}/${arch}"
    printf "\n"

    check_prerequisites
    mkdir -p "$GPD_BIN_DIR" "$GPD_PYTHON_DIR" "$GPD_VENV_DIR" "$GPD_CONFIG_DIR"

    log "Step 1/8: Installing OpenCode CLI..."
    install_opencode
    printf "\n"

    log "Step 2/8: Ensuring Python ${REQUIRED_PYTHON_MAJOR}.${REQUIRED_PYTHON_MINOR}+..."
    ensure_python
    printf "\n"

    log "Step 3/8: Installing GPD package..."
    install_gpd_package
    printf "\n"

    log "Step 4/8: Installing LaTeX tools..."
    install_latex
    printf "\n"

    log "Step 5/8: Configuring PSI key..."
    configure_litellm_key
    printf "\n"

    log "Step 6/8: Creating gpd command..."
    create_gpd_wrapper
    printf "\n"

    log "Step 7/8: Configuring PATH..."
    configure_path
    printf "\n"

    log "Step 8/8: Configuring GPD runtime..."
    configure_gpd_runtime
    printf "\n"

    print_success
}

main "$@"
