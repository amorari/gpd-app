Subject: [PATCH] feat(dialog,test): add data-action anchors to dialog-custom-provider (G5.2)

Stable anchors for the "Add a custom provider" form so tests-gui can
assert the dialog mounts and the submit button is addressable without
i18n-fragile text matching.

Adds:
  - data-component="dialog-custom-provider" on the root layout div
  - data-action="custom-provider-back"   on the back IconButton
  - data-action="custom-provider-submit" on the Submit button

Companion of test_dialog_custom_provider_has_stable_anchor (G5.2).

diff --git a/packages/app/src/components/dialog-custom-provider.tsx b/packages/app/src/components/dialog-custom-provider.tsx
--- a/packages/app/src/components/dialog-custom-provider.tsx
+++ b/packages/app/src/components/dialog-custom-provider.tsx
@@ -169,11 +169,12 @@ export function DialogCustomProvider(props: Props) {
           icon="arrow-left"
           variant="ghost"
           onClick={goBack}
           aria-label={language.t("common.goBack")}
+          data-action="custom-provider-back"
         />
       }
       transition
     >
-      <div class="flex flex-col gap-6 px-2.5 pb-3 overflow-y-auto max-h-[60vh]">
+      <div class="flex flex-col gap-6 px-2.5 pb-3 overflow-y-auto max-h-[60vh]" data-component="dialog-custom-provider">
         <div class="px-2.5 flex gap-4 items-center">
           <ProviderIcon id="synthetic" class="size-5 shrink-0 icon-strong-base" />
@@ -316,9 +317,10 @@ export function DialogCustomProvider(props: Props) {
           <Button
             class="w-auto self-start"
             type="submit"
             size="large"
             variant="primary"
             disabled={saveMutation.isPending}
+            data-action="custom-provider-submit"
           >
             {saveMutation.isPending ? language.t("common.saving") : language.t("common.submit")}
           </Button>
