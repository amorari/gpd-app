[run]
source = gpd_tests
branch = True
omit =
    */__init__.py
    */tests_unit/*
    */tests/*
    */scripts/*
    */vendor/*
parallel = True

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
show_missing = True
skip_covered = False
precision = 1
# Raise this floor incrementally as phases land. Starting from 2026-04-20 baseline
# of 56.6% + buffer for branch coverage.
fail_under = 55

[html]
directory = coverage_html
