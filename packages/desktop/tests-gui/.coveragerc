[run]
source = gpd_tests
branch = True
omit =
    */__init__.py
    */tests_unit/*
    */tests/*
    */scripts/*
    */vendor/*
parallel = True

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
show_missing = True
skip_covered = False
precision = 1

[html]
directory = coverage_html
