{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPD",
  "identifier": "inc.psi.gpd",
  "bundle": {
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/prod/32x32.png",
      "icons/prod/128x128.png",
      "icons/prod/128x128@2x.png",
      "icons/prod/icon.icns",
      "icons/prod/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/prod/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/inc.psi.gpd.metainfo.xml": "release/appstream.metainfo.xml"
        }
      },
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  },
  "plugins": {}
}
